{
  "name": "dscode",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @dscode/desktop build",
    "dev": "pnpm --filter @dscode/desktop dev",
    "fmt": "oxfmt",
    "lint": "eslint . && oxlint .",
    "lint:eslint": "eslint .",
    "lint:fast": "oxlint .",
    "lint:fix": "eslint . --fix && oxlint . --fix",
    "start": "pnpm --filter @dscode/desktop start",
    "typecheck": "pnpm --filter @dscode/desktop typecheck"
  },
  "devDependencies": {
    "@soybeanjs/eslint-config-vue": "^0.1.1",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.10.0",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.78.0"
  },
  "packageManager": "pnpm@11.17.0"
}
