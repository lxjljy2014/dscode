{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "useDefineForClassFields": true,
    "verbatimModuleSyntax": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@dscode/core": ["packages/core/src/index.ts"],
      "@dscode/shared": ["packages/shared/src/index.ts"],
      "@dscode/shared/settings": ["packages/shared/src/types/settings.ts"],
      "@dscode/shared/locales/*": ["packages/shared/src/locales/*"],
      "@dscode/ui": ["packages/ui/src/index.ts"],
      "@dscode/ui/tokens": ["packages/ui/src/theme/tokens.ts"],
      "@dscode/ui/global.css": ["packages/ui/src/theme/global.css"]
    }
  }
}
