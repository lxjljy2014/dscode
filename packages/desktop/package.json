{
  "name": "@dscode/desktop",
  "description": "DSCode —— AI 编程助手桌面客户端",
  "author": "DSCode",
  "version": "0.1.1",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "build": "electron-vite build",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "dist": "electron-vite build && electron-builder",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:linux": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@dscode/core": "workspace:*",
    "@dscode/shared": "workspace:*",
    "@dscode/ui": "workspace:*",
    "@fontsource-variable/inter": "^5.2.0",
    "@fontsource-variable/jetbrains-mono": "^5.2.0",
    "@iconify-json/lucide": "^1.2.0",
    "@types/node": "^24.0.0",
    "@unocss/preset-wind4": "^66.7.5",
    "@vitejs/plugin-vue": "^6.0.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "pinia": "^3.0.0",
    "sass-embedded": "^1.93.0",
    "typescript": "^5.9.0",
    "unocss": "^66.7.5",
    "vite": "^7.1.0",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^3.0.0",
    "vue": "^3.5.41",
    "vue-i18n": "^11.4.8",
    "vue-router": "^4.6.4",
    "vue-tsc": "^3.0.0",
    "vuetify": "^4.1.8"
  }
}
